  "narrative": {
    "northStar": "The Room at Dusk",
    "overview": "A dim plum study room lit by one warm lamp, a window of terracotta-to-mustard sky, and a tape deck on the desk. Product proof is rendered as tape objects: a unit is a cassette, its topics a tracklist, mastery a segmented level meter, subjects a stack of cassette cases on a shelf. Everything is soft and rounded; nothing is glossy or clinical.\n\nDensity is calm: generous section padding, short measures (34-38ch body), and one focal light per view. Depth comes from warm, soft, downward-offset ambient shadows and lamp glow rather than borders or cards.",
    "keyCharacteristics": [
      "Dark plum ground, cream text, warm dusk accents.",
      "Tape vocabulary: reels, J-card inserts, dotted fold rules, cassette spines.",
      "Segmented 10-step level meters for mastery.",
      "The brightest light is spent on exactly one element: the cued (next-up) track.",
      "Slow ambient motion (turning reels, breathing lamp) that stops under reduced motion."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "The lamp-light glow at full strength belongs to the single cued track; the hero lamp pool stays at ≤12% alpha.",
        "section": "colors"
      },
      {
        "name": "The Meter Scale Rule",
        "body": "Mastery is always sage strong, mustard developing, terracotta weak, as a 10-segment meter with unlit segments at cream 12%.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Scores, stats and codes use tabular-nums.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** express product data as tape objects: tracklists, reels, meters, spines.",
      "**Do** keep the 10-segment meter and its sage/mustard/terracotta scale for mastery.",
      "**Do** reserve the full lamp glow for one focused element per view.",
      "**Do** use dotted cream rules (2px, 14-20%) for divisions.",
      "**Do** stop reels, lamp breathing, meter pulse and hover lifts under prefers-reduced-motion."
    ],
    "donts": [
      "**Don't** use hard offset or black-edged shadows; shadows are soft, warm and negatively spread.",
      "**Don't** use square corners or solid hairline dividers.",
      "**Don't** spread lamp-strength glow across multiple items.",
      "**Don't** add eyebrow or kicker labels above headings."
    ]
  }
