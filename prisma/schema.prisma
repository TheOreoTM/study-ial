generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth) ──────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(STUDENT)
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  units         UserUnit[]
  attempts      Attempt[]
  studyPlans    StudyPlan[]
  focusSessions FocusSession[]
  aiUsage       AiUsage[]
  flashcards    Flashcard[]
  cardReviews   FlashcardReview[]
  milestones    UserMilestone[]
  papers        UserPaper[]
  ownedSittings PaperSitting[]
  paperAttempts PaperAttempt[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Curriculum ──────────────────────────────────────────────────────────────

model Subject {
  id          String  @id @default(cuid())
  slug        String  @unique // "physics"
  code        String  @unique // Pearson qualification code, e.g. "YPH11"
  name        String
  description String?
  color       String  @default("blue") // accent token used in the UI
  order       Int     @default(0)
  // Local (non-Pearson) subjects such as Islam
  isLocal     Boolean @default(false)

  units Unit[]
}

model Unit {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  code        String  @unique // Paper code, e.g. "WPH11"
  number      Int
  name        String
  description String?
  order       Int     @default(0)

  topics    Topic[]
  questions Question[]
  students  UserUnit[]
  plans     StudyPlanUnit[]
  sittings  PaperSitting[]

  @@unique([subjectId, number])
}

model Topic {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug       String // unique within a unit
  code       String // "1.2"
  name       String
  summary    String?
  // Specification learning outcomes, one per entry
  specPoints String[]
  order      Int      @default(0)

  questions  Question[]
  planTasks  StudyPlanTask[]
  focusTimes FocusSession[]
  flashcards Flashcard[]
  paperQuestions PaperQuestion[]

  @@unique([unitId, slug])
}

// ─── Question bank ───────────────────────────────────────────────────────────

enum QuestionType {
  MCQ
  SHORT // structured / short answer, marked against a mark scheme
  CALCULATION
  LONG // extended response (6-mark style)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  ORIGINAL
  PAST_PAPER
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

model Question {
  id          String         @id @default(cuid())
  // Stable key for seeded/imported questions so re-running the seed updates in place
  seedKey     String?        @unique
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        QuestionType
  difficulty  Difficulty     @default(MEDIUM)
  marks       Int
  // Markdown, supports $LaTeX$
  stem        String
  // Markdown mark scheme: one marking point per line
  markScheme  String
  explanation String?
  // Reviewed English translations of a question written in another language (Dhivehi Islam papers)
  stemEn       String?
  markSchemeEn String?
  source      QuestionSource @default(ORIGINAL)
  // e.g. "WPH11 Jan 2024 Q12" or a URL to the official paper
  sourceRef   String?
  status      QuestionStatus @default(DRAFT)
  // AI-written original questions: { model, generatedAt, selfCheck: { status, solverAnswer, notes }, similarity }
  generation  Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  options  QuestionOption[]
  attempts Attempt[]

  @@index([topicId, status])
  @@index([unitId, status])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String // "A"
  text       String
  isCorrect  Boolean  @default(false)

  attempts Attempt[]

  @@unique([questionId, label])
}

enum MarkingMethod {
  AUTO // MCQ
  SELF
  AI
}

model Attempt {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  answer           String?
  marksAwarded     Int
  maxMarks         Int
  method           MarkingMethod
  feedback         String?
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, questionId])
}

// Seed keys of seeded questions/flashcards an admin deleted, so re-running the seed doesn't bring them back.
model SeedTombstone {
  seedKey   String   @id
  deletedAt DateTime @default(now())
}

// ─── Flashcards ──────────────────────────────────────────────────────────────

// A card in a topic's deck. Shared cards (userId null) are seeded or written by admins and go through the same
// DRAFT → PUBLISHED review as questions. A student's own cards (userId set) are private to them.
model Flashcard {
  id        String         @id @default(cuid())
  seedKey   String?        @unique
  topicId   String
  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Markdown, supports $LaTeX$
  front     String
  back      String
  status    QuestionStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  reviews FlashcardReview[]

  @@index([topicId, status])
  @@index([userId, topicId])
}

// A student's spaced-repetition state for one card (created on first review).
model FlashcardReview {
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId    String
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  // Local calendar day (lib/time.ts) the card is next due
  dueDay         DateTime  @db.Date
  intervalDays   Int
  ease           Float
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime
  // Local day of the first review; caps how many new cards a student starts per day
  introducedDay  DateTime  @db.Date

  @@id([userId, flashcardId])
  @@index([userId, dueDay])
}

// ─── Student data ────────────────────────────────────────────────────────────

model UserUnit {
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  examDate DateTime?
  addedAt  DateTime  @default(now())

  @@id([userId, unitId])
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

model StudyPlan {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  startDate      DateTime
  examDate       DateTime
  minutesPerDay  Int
  // Days of the week to study, 0 = Sunday
  studyDays      Int[]
  status         PlanStatus @default(ACTIVE)
  // Optional AI-written overview of the plan
  summary        String?
  // Shared to the community plan library (template only: no author, progress or notes are shown)
  isPublic       Boolean    @default(false)
  sharedAt       DateTime?
  // The community plan this one was started from
  clonedFromId   String?
  clonedFrom     StudyPlan? @relation("PlanClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones         StudyPlan[] @relation("PlanClones")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tasks StudyPlanTask[]
  units StudyPlanUnit[]

  @@index([userId, status])
  @@index([isPublic, sharedAt])
}

// The units a plan covers, with the exam date it was planned against.
model StudyPlanUnit {
  planId   String
  plan     StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  examDate DateTime

  @@id([planId, unitId])
}

enum TaskType {
  LEARN
  PRACTICE
  REVIEW
  PAST_PAPER
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

model StudyPlanTask {
  id          String     @id @default(cuid())
  planId      String
  plan        StudyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  order       Int        @default(0)
  type        TaskType
  topicId     String?
  topic       Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title       String
  notes       String?
  minutes     Int
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  focusSessions FocusSession[]

  @@index([planId, date])
}

model FocusSession {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      StudyPlanTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  topicId   String?
  topic     Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  minutes   Int
  startedAt DateTime
  endedAt   DateTime       @default(now())

  @@index([userId, endedAt])
}

// AI tutor explanations. They depend only on curriculum content (never on a student), so one cached explanation
// serves every student until it expires.
model TutorExplanation {
  id        String   @id @default(cuid())
  kind      String // "topic" | "question"
  refId     String // Topic.id or Question.id
  point     Int // spec point index, or -1 for the whole topic / the question
  content   String
  model     String
  createdAt DateTime @default(now())

  @@unique([kind, refId, point])
}

// Milestones a student has earned (rules in lib/milestones.ts). Earned once and never taken away.
model UserMilestone {
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  // What earned it, e.g. the topic name or unit code
  detail   String?
  earnedAt DateTime  @default(now())
  seenAt   DateTime?

  @@id([userId, key])
}

// Per-user daily counters used to cap AI spend.
model AiUsage {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD (UTC)
  feature String
  count   Int    @default(0)

  @@id([userId, day, feature])
}

// Better Auth rate-limit counters (database storage so limits hold across serverless instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Past papers ─────────────────────────────────────────────────────────────
// Pearson papers are copyright: files live in private storage and are only served to signed-in users through
// app/api/papers/**. Public pages may show sitting metadata only. See docs/past-papers/.

enum PaperSeries {
  JAN
  JUN
  OCT
}

enum PaperDocType {
  QP // question paper
  MS // mark scheme
  ER // examiner report
}

enum PaperSource {
  PEARSON
  PMT
  UPLOAD
}

enum ParseStatus {
  NONE
  QUEUED
  PARSING
  NEEDS_REVIEW
  READY
  FAILED
}

// One exam sitting (unit + paper variant + series). Groups its QP, MS and ER. Public index sittings have no owner;
// a student's private upload gets its own sitting with ownerId set.
model PaperSitting {
  id        String       @id @default(cuid())
  subject   String // subject slug, e.g. "mathematics"
  spec      String? // "2018" | "2013"
  unitCode  String // "WMA11"
  unitId    String?
  unit      Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  paperCode String       @default("01") // "01", "01a", "01r"
  year      Int?
  series    PaperSeries?
  // Set for private uploads only
  ownerId   String?
  owner     User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String? // uploads: the student's own label
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  papers   Paper[]
  savedBy  UserPaper[]
  sessions PaperExamSession[]

  @@index([subject, unitCode, year])
  @@index([ownerId])
}

// One stored file: an indexed Pearson/PMT document or a student's upload.
model Paper {
  id             String       @id @default(cuid())
  sittingId      String
  sitting        PaperSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  type           PaperDocType
  source         PaperSource
  // Original URL exactly as listed (null for uploads). Lets serving switch to "fetch from source" per subject.
  sourceUrl      String?      @unique
  sourceTitle    String?
  // Storage key of the PDF, or of page 1 for an image upload (pages in pageKeys)
  storageKey     String
  pageKeys       String[]
  mime           String       @default("application/pdf")
  sha256         String
  sizeBytes      Int
  pageCount      Int
  // Date in the filename (publication date, not the sitting)
  publishedAt    DateTime?
  parseStatus    ParseStatus  @default(NONE)
  parseError     String?
  // Link checker
  lastCheckedAt  DateTime?
  lastCheckOk    Boolean?
  lastCheckNote  String?
  uploadedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  questions PaperQuestion[]

  @@index([sha256])
  @@index([sittingId, type])
  @@index([parseStatus])
  @@map("papers")
}

// Parse cache: each unique file (by hash) is parsed once and reused by every Paper with that content.
model PaperParse {
  id         String       @id @default(cuid())
  sha256     String
  docType    PaperDocType
  engine     String // "text" | "vision"
  model      String?
  result     Json
  validation Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([sha256, docType])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Database-backed background jobs (parsing, mark-scheme matching, topic tagging). Claimed with a lock so two
// runners never work on the same job; resumable through `state`.
model PaperJob {
  id         String    @id @default(cuid())
  kind       String // "parse" | "match" | "tag"
  paperId    String
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  // Engine progress so a long parse can resume across invocations
  state      Json?
  error      String?
  // User who triggered it (for AI quota); null for system/indexer jobs
  userId     String?
  lockedAt   DateTime?
  runAfter   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([paperId])
}

// A question, part or sub-part of a question paper. `number` is the full path ("3(b)(ii)"); parentId builds the tree.
model PaperQuestion {
  id           String          @id @default(cuid())
  paperId      String
  paper        Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       PaperQuestion?  @relation("PaperQuestionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     PaperQuestion[] @relation("PaperQuestionTree")
  number       String
  order        Int
  // Markdown with $LaTeX$ (and \ce{} for chemistry)
  stem         String
  // Marks for this part alone (0 for a question header whose marks sit in its parts)
  marks        Int             @default(0)
  // Page and region the part occupies ([x0,y0,x1,y1] fractions), for the "view on the page" crop
  page         Int?
  bbox         Float[]
  // [{ page, bbox, key }] figures cropped server-side from the page image
  figures      Json            @default("[]")
  dependsOn    String[]
  // Matched mark-scheme points [{ text, marks, code }] and notes
  markPoints   Json?
  markNotes    String?
  // Common mistakes noted in the examiner report (signed-in users only)
  examinerNotes String?
  topicId      String?
  topic        Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  // Admin/student edited this after parsing
  edited       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attempts PaperAttempt[]
  reviews  PaperQuestionReview[]

  @@unique([paperId, number])
  @@index([topicId])
}

// A sitting saved to a student's workspace ("Add to my papers").
model UserPaper {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sittingId String
  sitting   PaperSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  addedAt   DateTime     @default(now())

  @@id([userId, sittingId])
}

enum PaperMarkMethod {
  SELF
  AI // marked against matched mark-scheme points
  AI_ESTIMATED // no mark scheme available: the model estimated marks
}

model PaperAttempt {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     PaperQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      PaperExamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  answer       String?
  // Photos of handwritten working (private storage keys)
  imageKeys    String[]
  marksAwarded Int?
  maxMarks     Int
  method       PaperMarkMethod?
  // { points: [{ point, awarded, comment }], feedback }
  feedback     Json?
  createdAt    DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([sessionId])
}

enum ExamMode {
  PRACTICE
  TIMED
}

// A full-paper attempt (timed exam mode or untimed practice of the whole paper).
model PaperExamSession {
  id          String       @id @default(cuid())
  userId      String
  sittingId   String
  sitting     PaperSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  mode        ExamMode
  startedAt   DateTime     @default(now())
  // Timed mode deadline
  endsAt      DateTime?
  submittedAt DateTime?
  totalMarks  Int?
  maxMarks    Int?
  grade       String?
  summary     Json?

  attempts PaperAttempt[]

  @@index([userId, startedAt])
}

// Spaced repetition of paper questions a student dropped marks on (same SM-2 state as flashcards).
model PaperQuestionReview {
  userId         String
  questionId     String
  question       PaperQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  dueDay         DateTime      @db.Date
  intervalDays   Int
  ease           Float
  reps           Int           @default(0)
  lapses         Int           @default(0)
  lastReviewedAt DateTime

  @@id([userId, questionId])
  @@index([userId, dueDay])
}

// Raw-mark grade boundaries for one unit in one series, with where they came from.
model GradeBoundary {
  id        String      @id @default(cuid())
  unitCode  String
  paperCode String      @default("01")
  year      Int
  series    PaperSeries
  maxMark   Int
  // { "A*"?: n, A: n, B: n, C: n, D: n, E: n }
  grades    Json
  sourceUrl String
  createdAt DateTime    @default(now())

  @@unique([unitCode, paperCode, year, series])
}

// Every model call, for cost control and the admin spend view. No prompts or answers are stored here.
model AiCallLog {
  id           String   @id @default(cuid())
  userId       String?
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Estimated cost in micro-dollars (1e-6 USD)
  costMicros   Int      @default(0)
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}
