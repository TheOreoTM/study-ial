generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth) ──────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(STUDENT)
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  units         UserUnit[]
  attempts      Attempt[]
  studyPlans    StudyPlan[]
  focusSessions FocusSession[]
  aiUsage       AiUsage[]
  flashcards    Flashcard[]
  cardReviews   FlashcardReview[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Curriculum ──────────────────────────────────────────────────────────────

model Subject {
  id          String  @id @default(cuid())
  slug        String  @unique // "physics"
  code        String  @unique // Pearson qualification code, e.g. "YPH11"
  name        String
  description String?
  color       String  @default("blue") // accent token used in the UI
  order       Int     @default(0)
  // Local (non-Pearson) subjects such as Dhivehi or Islam
  isLocal     Boolean @default(false)

  units Unit[]
}

model Unit {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  code        String  @unique // Paper code, e.g. "WPH11"
  number      Int
  name        String
  description String?
  order       Int     @default(0)

  topics    Topic[]
  questions Question[]
  students  UserUnit[]
  plans     StudyPlanUnit[]

  @@unique([subjectId, number])
}

model Topic {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug       String // unique within a unit
  code       String // "1.2"
  name       String
  summary    String?
  // Specification learning outcomes, one per entry
  specPoints String[]
  order      Int      @default(0)

  questions  Question[]
  planTasks  StudyPlanTask[]
  focusTimes FocusSession[]
  flashcards Flashcard[]

  @@unique([unitId, slug])
}

// ─── Question bank ───────────────────────────────────────────────────────────

enum QuestionType {
  MCQ
  SHORT // structured / short answer, marked against a mark scheme
  CALCULATION
  LONG // extended response (6-mark style)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  ORIGINAL
  PAST_PAPER
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

model Question {
  id          String         @id @default(cuid())
  // Stable key for seeded/imported questions so re-running the seed updates in place
  seedKey     String?        @unique
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        QuestionType
  difficulty  Difficulty     @default(MEDIUM)
  marks       Int
  // Markdown, supports $LaTeX$
  stem        String
  // Markdown mark scheme: one marking point per line
  markScheme  String
  explanation String?
  source      QuestionSource @default(ORIGINAL)
  // e.g. "WPH11 Jan 2024 Q12" or a URL to the official paper
  sourceRef   String?
  status      QuestionStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  options  QuestionOption[]
  attempts Attempt[]

  @@index([topicId, status])
  @@index([unitId, status])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String // "A"
  text       String
  isCorrect  Boolean  @default(false)

  attempts Attempt[]

  @@unique([questionId, label])
}

enum MarkingMethod {
  AUTO // MCQ
  SELF
  AI
}

model Attempt {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  answer           String?
  marksAwarded     Int
  maxMarks         Int
  method           MarkingMethod
  feedback         String?
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, questionId])
}

// Seed keys of seeded questions/flashcards an admin deleted, so re-running the seed doesn't bring them back.
model SeedTombstone {
  seedKey   String   @id
  deletedAt DateTime @default(now())
}

// ─── Flashcards ──────────────────────────────────────────────────────────────

// A card in a topic's deck. Shared cards (userId null) are seeded or written by admins and go through the same
// DRAFT → PUBLISHED review as questions. A student's own cards (userId set) are private to them.
model Flashcard {
  id        String         @id @default(cuid())
  seedKey   String?        @unique
  topicId   String
  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Markdown, supports $LaTeX$
  front     String
  back      String
  status    QuestionStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  reviews FlashcardReview[]

  @@index([topicId, status])
  @@index([userId, topicId])
}

// A student's spaced-repetition state for one card (created on first review).
model FlashcardReview {
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId    String
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  // Local calendar day (lib/time.ts) the card is next due
  dueDay         DateTime  @db.Date
  intervalDays   Int
  ease           Float
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime
  // Local day of the first review; caps how many new cards a student starts per day
  introducedDay  DateTime  @db.Date

  @@id([userId, flashcardId])
  @@index([userId, dueDay])
}

// ─── Student data ────────────────────────────────────────────────────────────

model UserUnit {
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  examDate DateTime?
  addedAt  DateTime  @default(now())

  @@id([userId, unitId])
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

model StudyPlan {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  startDate      DateTime
  examDate       DateTime
  minutesPerDay  Int
  // Days of the week to study, 0 = Sunday
  studyDays      Int[]
  status         PlanStatus @default(ACTIVE)
  // Optional AI-written overview of the plan
  summary        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tasks StudyPlanTask[]
  units StudyPlanUnit[]

  @@index([userId, status])
}

// The units a plan covers, with the exam date it was planned against.
model StudyPlanUnit {
  planId   String
  plan     StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  examDate DateTime

  @@id([planId, unitId])
}

enum TaskType {
  LEARN
  PRACTICE
  REVIEW
  PAST_PAPER
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

model StudyPlanTask {
  id          String     @id @default(cuid())
  planId      String
  plan        StudyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  order       Int        @default(0)
  type        TaskType
  topicId     String?
  topic       Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title       String
  notes       String?
  minutes     Int
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  focusSessions FocusSession[]

  @@index([planId, date])
}

model FocusSession {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      StudyPlanTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  topicId   String?
  topic     Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  minutes   Int
  startedAt DateTime
  endedAt   DateTime       @default(now())

  @@index([userId, endedAt])
}

// AI tutor explanations. They depend only on curriculum content (never on a student), so one cached explanation
// serves every student until it expires.
model TutorExplanation {
  id        String   @id @default(cuid())
  kind      String // "topic" | "question"
  refId     String // Topic.id or Question.id
  point     Int // spec point index, or -1 for the whole topic / the question
  content   String
  model     String
  createdAt DateTime @default(now())

  @@unique([kind, refId, point])
}

// Per-user daily counters used to cap AI spend.
model AiUsage {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD (UTC)
  feature String
  count   Int    @default(0)

  @@id([userId, day, feature])
}

// Better Auth rate-limit counters (database storage so limits hold across serverless instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
