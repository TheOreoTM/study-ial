generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}







enum Difficulty {
    EASY
    MEDIUM
    HARD
    VERY_HARD
}

enum QuestionType {
    MCQ
    STRUCTURED
    ESSAY
    GRAPH
    TABLE
    MIXED
    DIAGRAM
    CALCULATION
}

enum TaskType {
    READ
    REVISE
    PRACTICE_QUESTIONS
    MOCK_PAPER
    REVIEW
}

enum Status {
    PENDING
    IN_PROGRESS
    DONE
    SKIPPED
}

enum ProgressStatus {
    NOT_ATTEMPTED
    ATTEMPTED
    CORRECT
    INCORRECT
}

enum AssetType {
    DIAGRAM
    GRAPH
    TABLE_IMAGE
    FORMULA_IMAGE
    PHOTO
}
