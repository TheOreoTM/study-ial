// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  
  apiKeys       ApiKey[]
  studyPlans    StudyPlan[]
  progress      UserQuestionProgress[]
  resources     Resource[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Subject {
  id          String   @id @default(nanoid())
  code        String   @unique // e.g. "PHYS", "CHEM", "BIOL", "MATH", "ISLM", "DHIV"
  name        String // "Physics", "Chemistry", "Biology", "Mathematics", "Islam", "Dhivehi"
  description String?
  createdAt   DateTime @default(now())

  units        Unit[]
  topics       Topic[]
  sourcePapers SourcePaper[]
  questions    Question[]
  studyPlans   StudyPlan[]
  studyPlanItems StudyPlanItem[]
}

model Unit {
  id          String   @id @default(nanoid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  code        String // Official paper code
  name        String
  description String?
  createdAt   DateTime @default(now())

  topics    Topic[]
  questions Question[]

  @@unique([subjectId, code])
  @@index([subjectId])
}

model Topic {
  id            String  @id @default(nanoid())
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id])
  unitId        String
  unit          Unit    @relation(fields: [unitId], references: [id])
  code          String
  name          String
  slug          String  @unique
  parentTopicId String?
  parentTopic   Topic?  @relation("TopicChildren", fields: [parentTopicId], references: [id])
  children      Topic[] @relation("TopicChildren")

  createdAt DateTime @default(now())

  questions Question[]

  @@unique([unitId, code])
  @@index([subjectId])
  @@index([unitId])
}

model ApiKey {
  id        String    @id @default(nanoid())
  key       String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  userId    String

  @@index([key])
}

model SourcePaper {
  id               String   @id @default(uuid())
  subjectId        String
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  year             Int
  session          String // "jan", "may", "sep"
  variant          Int? // 1, 2, 3, etc.
  paper            Int? // for subjects with multiple papers
  storageUrl       String
  markingSchemeUrl String?
  pageCount        Int?
  createdAt        DateTime @default(now())

  questions     Question[]
  ingestionJobs IngestionJob[]

  @@index([subjectId, year, session])
  @@map("source_papers")
}

model Question {
  id                   String       @id @default(uuid())
  subjectId            String
  subject              Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId               String?
  unit                 Unit?        @relation(fields: [unitId], references: [id])
  primaryTopicId       String
  primaryTopic         Topic        @relation(fields: [primaryTopicId], references: [id])
  difficulty           Difficulty   @default(MEDIUM)
  questionType         QuestionType @default(MIXED)
  hasDiagram           Boolean      @default(false)
  hasMath              Boolean      @default(false)
  hasTable             Boolean      @default(false)
  embedding            Unsupported("vector(1536)")?
  metadata             Json?
  sourcePaperId        String?
  sourcePaper          SourcePaper? @relation(fields: [sourcePaperId], references: [id])
  sourcePage           Int?
  sourceQuestionNumber String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now()) @updatedAt

  parts    QuestionPart[]
  assets   QuestionAsset[]
  progress UserQuestionProgress[]

  @@index([subjectId, primaryTopicId])
  @@index([difficulty])
  @@index([sourcePaperId, sourceQuestionNumber])
  @@map("questions")
}

model QuestionPart {
  id                    String   @id @default(uuid())
  questionId            String
  question              Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label                 String // "a", "b", "i", "ii", etc.
  promptPlain           String?
  promptRich            Json?
  marks                 Int?
  answerExplanationRich Json?
  order                 Int
  createdAt             DateTime @default(now())

  options AnswerOption[]
  assets  QuestionAsset[]

  @@index([questionId])
  @@map("question_parts")
}

model AnswerOption {
  id             String       @id @default(uuid())
  questionPartId String
  questionPart   QuestionPart @relation(fields: [questionPartId], references: [id], onDelete: Cascade)
  label          String // "A", "B", "C", "D"
  contentRich    Json
  contentPlain   String?
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  @@index([questionPartId])
  @@map("answer_options")
}

model QuestionAsset {
  id             String        @id @default(uuid())
  questionId     String
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionPartId String?
  questionPart   QuestionPart? @relation(fields: [questionPartId], references: [id], onDelete: Cascade)
  type           AssetType
  storageUrl     String
  altText        String?
  bboxData       Json?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([questionId])
  @@map("question_assets")
}

model StudyPlan {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id])
  startDate        DateTime
  endDate          DateTime
  totalTargetHours Decimal? @db.Decimal(10, 2)
  settings         Json?
  generatedByModel String?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  items StudyPlanItem[]

  @@index([userId])
  @@map("study_plans")
}

model StudyPlanItem {
  id                   String    @id @default(uuid())
  planId               String
  plan                 StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId            String
  subject              Subject   @relation(fields: [subjectId], references: [id])
  topicIds             Json?
  questionIds          Json?
  taskType             TaskType
  status               Status    @default(PENDING)
  dueDate              DateTime
  targetQuestionsCount Int?
  targetMinutes        Int?
  metadata             Json?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  @@index([planId])
  @@index([dueDate])
  @@map("study_plan_items")
}

model UserQuestionProgress {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status             ProgressStatus @default(NOT_ATTEMPTED)
  lastAnsweredAt     DateTime?
  timesAttempted     Int            @default(0)
  timesCorrect       Int            @default(0)
  difficultyEstimate Decimal?       @db.Decimal(3, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@index([userId, questionId])
  @@index([userId])
  @@map("user_question_progress")
}

model IngestionJob {
  id                 String      @id @default(uuid())
  sourcePaperId      String
  sourcePaper        SourcePaper @relation(fields: [sourcePaperId], references: [id], onDelete: Cascade)
  status             String      @default("pending")
  totalQuestions     Int?
  processedQuestions Int         @default(0)
  errorLog           Json?
  rawGeminiOutput    Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())

  @@index([status])
  @@index([sourcePaperId])
  @@map("ingestion_jobs")
}

model Resource {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  fileSize  Int
  pageCount Int?
  createdAt DateTime @default(now())

  chunks ResourceChunk[]

  @@index([userId])
  @@map("resources")
}

model ResourceChunk {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@map("resource_chunks")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum QuestionType {
  MCQ
  STRUCTURED
  ESSAY
  GRAPH
  TABLE
  MIXED
  DIAGRAM
  CALCULATION
}

enum TaskType {
  READ
  REVISE
  PRACTICE_QUESTIONS
  MOCK_PAPER
  REVIEW
}

enum Status {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum ProgressStatus {
  NOT_ATTEMPTED
  ATTEMPTED
  CORRECT
  INCORRECT
}

enum AssetType {
  DIAGRAM
  GRAPH
  TABLE_IMAGE
  FORMULA_IMAGE
  PHOTO
}
