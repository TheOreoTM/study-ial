# ── Database (Neon in production; `pnpm db:dev` locally) ─────────────────────
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
# Max connections per server instance (default 5; use 3 with the local `prisma dev` server)
DATABASE_POOL_MAX=""
# Only needed for `prisma migrate dev` against a local server
SHADOW_DATABASE_URL=""

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in (optional — the button hides itself when these are empty)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (optional — emails are printed to the server log when empty)
RESEND_API_KEY=""
EMAIL_FROM="Study-IAL <noreply@example.com>"

# Comma-separated emails that get the ADMIN role — only once the address is verified
# (Google sign-in, or email verification via Resend). Unverified sign-ups never become admin.
ADMIN_EMAILS=""

# ── AI (optional — AI features degrade gracefully when empty) ────────────────
OPENROUTER_API_KEY=""
# Override model choices if you like (any OpenRouter model id)
AI_MODEL_FAST="google/gemini-2.5-flash"
AI_MODEL_SMART="google/gemini-2.5-pro"
# Per-user daily caps
AI_DAILY_LIMIT_MARKING="40"
AI_DAILY_LIMIT_PLAN="5"

# ── Past papers ──────────────────────────────────────────────────────────────
# Private file storage on Cloudflare R2 (S3 API). Leave all four empty to use the local filesystem (.storage/),
# which is what development and tests use. The bucket must stay private: files are only served through
# authenticated routes as 5-minute signed URLs.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Where local storage writes when R2 is not configured (default: ./.storage)
STORAGE_LOCAL_DIR=""
# Months after a sitting during which papers are treated as centre-login only and never indexed (minimum 12)
PAPERS_RESTRICTED_MONTHS="12"
# Shown on the takedown page and paper footers
NEXT_PUBLIC_TAKEDOWN_EMAIL=""
# Vercel Cron sends this as a bearer token to /api/papers/jobs (daily sweep of the parse queue)
CRON_SECRET=""
# Vision model for reading scans/photos and upgrading stems to LaTeX (any OpenRouter vision model)
AI_MODEL_VISION="google/gemini-2.5-flash"
# Per-user daily caps for paper reading (model calls) and admin question generation
AI_DAILY_LIMIT_PARSE="30"
AI_DAILY_LIMIT_GENERATE="60"
# Upload limits
PAPERS_UPLOAD_MAX_MB="4"
PAPERS_UPLOAD_MAX_PAGES="60"
PAPERS_UPLOAD_MAX_IMAGES="30"
PAPERS_UPLOADS_PER_DAY="10"
